# Gnani (app.gnani.ai/voice)
GNANI_API_KEY=
# LLM: any OpenAI-compatible endpoint. LLM2_* and LLM3_* are optional overflow providers,
# used when the one before hits a rate limit. MODEL may list several models, comma-separated.
# For Evon v3.3 served by vLLM, set a BASE_URL to the vLLM URL and MODEL to the Evon model id.
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_API_KEY=
LLM2_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
PORT=8790
# DEMO_DATE=2026-11-20   moves the clock to that day (keeps the time of day)
