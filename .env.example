# Gnani (app.gnani.ai/voice)
GNANI_API_KEY=
# Any OpenAI-compatible chat endpoint. Default: Gemini (free key at aistudio.google.com).
# For Evon v3.3 served by vLLM, set LLM_BASE_URL to the vLLM URL and LLM_MODEL to the Evon model id.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Several models, comma-separated: the next one is used on a rate limit. Groq example:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
PORT=8790
